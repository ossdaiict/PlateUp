<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/roleIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_back"
        android:padding="6dp"
        android:src="@drawable/ic_person"
        app:tint="@color/primary_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/contactNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/callButton"
        app:layout_constraintStart_toEndOf="@id/roleIcon"
        app:layout_constraintTop_toTopOf="@id/roleIcon"
        tools:text="Rahul Kumar" />

    <TextView
        android:id="@+id/contactRoleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/contactNameText"
        app:layout_constraintTop_toBottomOf="@id/contactNameText"
        tools:text="Vendor" />

    <TextView
        android:id="@+id/contactPhoneText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/primary_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/contactRoleText"
        app:layout_constraintTop_toBottomOf="@id/contactRoleText"
        tools:text="+91 9876543210" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/callButton"
        style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:icon="@drawable/ic_phone"
        app:iconTint="@color/primary"
        android:padding="0dp"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
