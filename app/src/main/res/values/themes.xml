<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PlateUp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="editTextStyle">@style/Widget.App.EditText</item>
    </style>

    <style name="Widget.App.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="Theme.PlateUp" parent="Base.Theme.PlateUp" />

    <style name="Theme.PlateUp.Splash" parent="Theme.PlateUp">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="RatingBarTheme" parent="Theme.AppCompat">
        <item name="colorControlNormal">@color/text_hint</item>
        <item name="colorControlActivated">@color/primary_dark</item>
    </style>
</resources>